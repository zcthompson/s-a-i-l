# S-A-I-L (Sales Analytics and Intelligence Launchpad) — example environment file
#
# Copy to `.env` (repo root). The backend loads it via load_dotenv() in
# backend/main.py (also tests/backend/conftest.py and alembic/env.py).
# Every variable the application reads is listed with a working example
# value; values marked (example) are placeholders to replace.
#
# NOTE: no local-inference model values are included — point
# SAIL_AI_ENDPOINT at your OpenAI-compatible endpoint and set the
# matching key and model.

# Runtime/database additions (see docs/runtime-database.md):
# DATABASE_URL overrides SAIL_DATABASE_URL if explicitly set. PostgreSQL is
# still under parity validation; do not switch an existing deployment yet.
# DB_SSLMODE=verify-full
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# SAIL_FILES_DIR=/data/files
# SQLITE_NETWORK_FS=false
# RUN_MIGRATIONS_ON_START=true  # image default; local settings default false
# DOCLING_URL overrides SAIL_DOCLING_SERVER_URL when set.
# DOCLING_TIMEOUT_SECONDS=600
# DOCLING_STARTUP_GRACE_SECONDS=300

# ── AI inference (backend/config.py) ─────────────────────────────────────
# OpenAI-compatible endpoint. (example — replace with yours)
SAIL_AI_ENDPOINT=https://api.openai.com/v1
# Inference API key. (example — replace with yours)
SAIL_AI_API_KEY=your-api-key-here
# Model name sent to the endpoint. (example — replace with yours)
SAIL_AI_MODEL=gpt-4o
# Inference connection trust model (SSL/TLS): full | skip | ca
#   full = verify chain + hostname (default, recommended)
#   skip = TLS on but verification OFF (high-risk — internal/dev only)
#   ca   = verify against SAIL_INFER_SSL_CA_BUNDLE (a custom CA)
SAIL_INFER_SSL_VERIFY=full
# PEM CA bundle (one or more certs) for ssl_verify=ca. Leave empty unless
# connecting to an endpoint signed by a custom/self-signed internal CA.
SAIL_INFER_SSL_CA_BUNDLE=

# ── Docling Serve (document normalization) ──────────────────────────────
# Docling Serve base URL. (example — replace with yours)
SAIL_DOCLING_SERVER_URL=http://localhost:5001
# Docling API key (example — empty means no Authorization header is sent)
SAIL_DOCLING_API_KEY=
# Docling conversion timeout in seconds (default 600)
SAIL_DOCLING_TIMEOUT_SECONDS=600
# Docling connection trust model (SSL/TLS): full | skip | ca
SAIL_DOCLING_SSL_VERIFY=full
# PEM CA bundle for ssl_verify=ca (leave empty unless a custom CA is used)
SAIL_DOCLING_SSL_CA_BUNDLE=

# ── Azure Document Intelligence (optional alternative provider) ─────────
# Only used when the document processing provider is set to Azure in
# Application Settings → Document Processing (admin, DB-persisted).
# Environment defaults for the admin-editable settings:
#SAIL_AZURE_DI_ENDPOINT=
# Subscription key — environment/Secret-only, NEVER stored in the app
# database or returned by any API (the UI reports configured/not
# configured only). Leave empty while the provider is Docling.
SAIL_AZURE_DI_API_KEY=

# ── Email notifications (SMTP; admin → Application Settings →
#    Notifications & ticketing → Email notifications) ──────────────────
# Master switch: while false (or host/from blank) notifications stay
# in-app-only. Admin-editable values live in Application Settings (DB);
# the environment values are the defaults the admin UI shows.
SAIL_EMAIL_ENABLED=false
# SMTP server. (example — replace with yours)
SAIL_EMAIL_SMTP_HOST=
# STARTTLS (default, port 587) or implicit TLS/SSL (port 465)
SAIL_EMAIL_SMTP_PORT=587
SAIL_EMAIL_SMTP_USERNAME=
# SECRET — the SMTP password. Keep in .env / k8s Secret only; it is never
# stored in the app database and the admin UI reports configured / not
# configured only.
SAIL_EMAIL_SMTP_PASSWORD=
# Trust mode: starttls (default) | ssl | none
SAIL_EMAIL_SMTP_SECURITY=starttls
# The From: address of outgoing notification mail.
SAIL_EMAIL_FROM_ADDRESS=

# ── LDAP/AD directory auth (disabled by default) ──────────────────
# Master switch — local login is the ONLY path while this is false.
SAIL_AUTH_LDAP_ENABLED=false
# Directory URI. 636 LDAPS and 389 LDAP are both first-class:
#   ldaps://dc01.corp.example:636            (implicit TLS)
#   ldap://dc01.corp.example:389  (+ START_TLS=true)
SAIL_AUTH_LDAP_SERVER_URI=
# Read-only service account used to SEARCH the directory (bind DN).
SAIL_AUTH_LDAP_SERVICE_BIND_DN=
# SECRET — the service-account password. Keep in .env / k8s Secret only;
# it is never stored in the DB and never shown in the admin UI.
SAIL_AUTH_LDAP_SERVICE_BIND_PASSWORD=
SAIL_AUTH_LDAP_USER_SEARCH_BASE_DN=
# Parameterized filter — exactly one {username} placeholder.
# AD: (sAMAccountName={username})   generic LDAP: (uid={username})
SAIL_AUTH_LDAP_USER_SEARCH_FILTER=
# StartTLS upgrade for ldap://:389 (with require_tls, plain ldap:// without
# StartTLS is refused at save time)
SAIL_AUTH_LDAP_START_TLS=false
SAIL_AUTH_LDAP_REQUIRE_TLS=true
# Trust model (P0b seam): full | skip | ca
SAIL_AUTH_LDAP_SSL_VERIFY=full
# PEM CA bundle for ssl_verify=ca (leave empty unless a custom CA is used)
SAIL_AUTH_LDAP_SSL_CA_BUNDLE=
SAIL_AUTH_LDAP_TIMEOUT_SECONDS=5
# Attribute mapping (defaults shown — AD values; generic LDAP may use
# entryUUID for the external id, departmentNumber or ou for department)
SAIL_AUTH_LDAP_EMAIL_ATTR=mail
SAIL_AUTH_LDAP_DISPLAY_NAME_ATTR=displayName
SAIL_AUTH_LDAP_DEPARTMENT_ATTR=department
SAIL_AUTH_LDAP_EXTERNAL_ID_ATTR=objectGUID
# JIT policy: directory identity already proven → skip the local
# pending-approval queue (set false to route directory users through it).
SAIL_AUTH_LDAP_AUTO_APPROVE=true
# Role granted to JIT directory users ("admin" is refused by policy)
SAIL_AUTH_LDAP_DEFAULT_ROLE=user
# Ops kill-switch: reject directory logins (local unaffected)
SAIL_AUTH_LDAP_LOGIN_DISABLED=false
# Local self-registration (default true = today's behavior; the admin
# Application-Settings area can hide the Register form when the
# directory is the intended onboarding path)
SAIL_AUTH_LDAP_LOCAL_REGISTER_ENABLED=true

# ── Database ────────────────────────────────────────────────────────────
# SQLAlchemy URL. SQLite is the supported engine. Dev: relative path (file
# lands in the working directory); production PVC: four slashes (sqlite://
# + absolute path), e.g. sqlite:////data/sail.db
SAIL_DATABASE_URL=sqlite:///./sail.db
# Optional fallbacks read before SAIL_DATABASE_URL (documented, A-9):
#   DATABASE_URL — alembic/env.py falls back to it when SAIL_DATABASE_URL
#                  is unset (migrations run outside the app).
#   DB_PATH      — scripts/sync_departments.py direct-file path (ops script).

# ── JWT / authentication (backend/auth.py) ────────────────────────────────
# MANDATORY — the backend raises RuntimeError and refuses to start when this
# is empty, below 32 characters, or a documented placeholder value
# ("change-me-in-production", "changeme-changeme-changeme-changeme").
# Generate a real one: openssl rand -hex 32   (leave blank and fill in)
SAIL_JWT_SECRET=
# JWT lifetime in minutes (default 1440 = 24 h)
SAIL_TOKEN_EXPIRE_MINUTES=1440
# Brute-force login lockout (defaults shown)
SAIL_LOGIN_MAX_ATTEMPTS=5
SAIL_LOGIN_LOCKOUT_MINUTES=15
# Bounded in-memory tracking of lockout attempts (A-8: own bound name;
# SAIL_TRACKED_REQUESTS still works as a fallback alias)
SAIL_LOGIN_TRACKED_REQUESTS=500
# Bounded metrics history for /api/monitoring (default 1000)
SAIL_METRICS_HISTORY=1000

# ── Password policy (defaults shown; tighten for production) ─────────────
SAIL_MIN_PASSWORD_LENGTH=4
SAIL_REQUIRE_UPPERCASE=false
SAIL_REQUIRE_LOWERCASE=false
SAIL_REQUIRE_DIGIT=false
SAIL_REQUIRE_SPECIAL=false

# ── API keys & rate limiting (backend/auth.py, backend/rate_limit.py) ─────
# Comma-separated X-API-Key values (credential list; only consumed by the
# optional per-key department restrictions, SAIL_DEPT_RESTRICTIONS).
# (example value from docker-compose.yml — replace)
SAIL_API_KEYS=replace-with-a-random-api-key
# A-10 (operator ruling 2026-11-01): the explicit auth feature switch.
# true/1/yes/on = auth ON, false/0/no/off = auth OFF, UNSET = legacy rule
# (auth ON iff SAIL_API_KEYS is non-empty). The deploy wrappers default it
# to `true`.
SAIL_AUTH_ENABLED=
# Per-IP rate limit over /api/* (requests per window, window in seconds).
# Code defaults are 10000 / 3600.
SAIL_RATE_LIMIT_REQUESTS=10000
SAIL_RATE_LIMIT_WINDOW=3600
# Strict per-IP auth-flow buckets (SEC-02). login is the general default;
# register is tighter. Code defaults: login 10/3600, register 5/3600.
SAIL_LOGIN_RATE_LIMIT_REQUESTS=10
SAIL_LOGIN_RATE_LIMIT_WINDOW=3600
SAIL_REGISTER_RATE_LIMIT_REQUESTS=5
SAIL_REGISTER_RATE_LIMIT_WINDOW=3600
# Comma-separated direct-peer IPs trusted to supply X-Forwarded-For /
# X-Real-IP. Empty (default) = forwarded headers are ignored and the direct
# peer is always used. Set to your load balancer / proxy IP behind a LB.
SAIL_TRUSTED_PROXIES=
# Upload ceiling in bytes (SEC-03); 413 before persistence, 400 on empty.
# Code default 10485760 (10 MiB).
SAIL_MAX_UPLOAD_BYTES=10485760
# Password policy (SEC-04). Minimum length code default is 12; the bcrypt
# cost is fixed at 12 (not configurable). Extra strength flags default off.
SAIL_MIN_PASSWORD_LENGTH=12
# Optional per-API-key department scoping.
# Format: key:scope:dept1|dept2[,key:scope:dept...] where scope is a
# customer name or "all" (scope "all" grants admin-level department
# visibility). (example entry; leave empty for no restrictions)
SAIL_DEPT_RESTRICTIONS=replace-with-a-random-api-key:Acme Manufacturing:Customer Success|Operations

# ── CORS (backend/main.py) ───────────────────────────────────────────────
# Comma-separated allowed origins; empty = open (*) — tighten for production.
SAIL_CORS_ORIGINS=*

# ── Frontend serving (backend/main.py) ────────────────────────────────────
# 1/true: the backend serves the built SPA (frontend/dist) + /assets —
# single-origin production topology. Any other value: API-only service.
# (Unprefixed by deployment convention — the one deliberate raw read.)
SERVE_FRONTEND=1

# ── Integration env fallbacks (services/integration_service.py; A-9) ─────
# Stored Application-Settings values win; these are env fallbacks. The
# SAIL_-prefixed names are canonical — the unprefixed legacy names
# (SLACK_WEBHOOK_URL / TEAMS_WEBHOOK_URL / JIRA_URL / JIRA_API_KEY /
# JIRA_PROJECT_KEY) are still read as aliases.
SAIL_SLACK_WEBHOOK_URL=
SAIL_TEAMS_WEBHOOK_URL=
SAIL_JIRA_URL=
SAIL_JIRA_API_KEY=
SAIL_JIRA_PROJECT_KEY=
